{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=orderdb;Username=postgres;Password=postgres"
  },
  "RabbitMq": {
    "ConnectionString": "amqp://guest:guest@localhost:5672",
    "Exchange": "quickapp.events",
    "OrderPlacedRoutingKey": "order.placed",
    "OrderPlacedQueue": "notification.order-placed"
  },
  "Gateway": {
    "BaseUrl": "http://localhost:5000",
    "CustomerPath": "/api/customers",
    "ProductPath": "/api/products",
    "IdentityUserPath": "/api/identity/users",
    "TimeoutSeconds": 3
  }
}
